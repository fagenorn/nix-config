{
  "format": 1,
  "keep_alive": {"command": "forge-claim", "subcommand": "renew", "in": ["run.repo", "run.issue", "run.holder"]},
  "inputs": ["holder", "issue", "repo", "repo_root"],
  "stops": {
    "setup": {"need": "owner-decision", "reenter": "contract"},
    "review-blocked": {"need": "owner-decision", "reenter": "contract"},
    "claimed": {"need": "owner-decision", "reenter": "contract"},
    "claim": {"need": "retry", "reenter": "acquire"},
    "claim-lost": {"need": "owner-decision", "reenter": "contract"},
    "dirty": {"need": "owner-decision", "reenter": "worktree"},
    "look-not-on-engine": {"need": "nothing", "reenter": "look"}
  },
  "steps": [
    {"id": "contract", "stage": "setup", "kind": "command", "command": "resolve-project", "subcommand": "resolve",
     "holds": "live", "in": ["run.repo_root"], "on": {"ok": "review", "failed": "setup", "refused": "setup"}},
    {"id": "review", "stage": "setup", "kind": "decide", "grader": "review-capability", "holds": "run",
     "in": ["contract.capabilities"], "on": {"clear": "preflight", "blocked": "review-blocked"}},
    {"id": "preflight", "stage": "setup", "kind": "command", "command": "issue-setup", "subcommand": "preflight",
     "holds": "live", "in": ["run.repo_root", "run.issue"],
     "on": {"clear": "existing", "closed": "setup", "parked": "setup", "duplicate": "setup", "open-pr": "setup",
            "error": "setup", "refused": "setup"}},
    {"id": "existing", "stage": "setup", "kind": "command", "command": "issue-setup", "subcommand": "worktree-check",
     "holds": "run", "in": ["run.repo_root", "preflight.branch", "preflight.worktree_path"],
     "on": {"absent": "applies", "adopted": "applies", "dirty": "applies", "mismatch": "setup",
            "error": "setup", "refused": "setup"}},
    {"id": "applies", "stage": "setup", "kind": "agent", "role": "reviewer-lite", "prompt": "setup-applies.md",
     "reply": "setup-applies.reply.json", "outcome_from": "verdict", "holds": "run",
     "in": ["run.issue", "run.repo", "preflight.integration_branch", "preflight.issue_text"],
     "on": {"applies": "acquire", "no-longer-applies": "note", "no-reply": "setup", "out-of-bounds": "setup"}},
    {"id": "note", "stage": "setup", "kind": "command", "command": "issue-setup", "subcommand": "note",
     "holds": "run", "in": ["run.repo", "run.issue", "applies.evidence"],
     "on": {"posted": "setup", "error": "setup", "refused": "setup"}},
    {"id": "acquire", "stage": "setup", "kind": "command", "command": "forge-claim", "subcommand": "acquire",
     "holds": "live", "in": ["run.repo", "run.issue", "run.holder", "preflight.branch"],
     "on": {"acquired": "worktree", "already_held": "worktree", "held_by": "claimed", "lost_to": "claimed",
            "error": "claim", "refused": "claim"}},
    {"id": "worktree", "stage": "setup", "kind": "command", "command": "issue-setup", "subcommand": "worktree",
     "holds": "live", "in": ["run.repo_root", "preflight.branch", "preflight.worktree_path"], "mutates": true,
     "check": {"command": "issue-setup", "subcommand": "worktree-check"},
     "on": {"made": "look", "adopted": "look", "dirty": "dirty", "mismatch": "setup", "error": "claim",
            "refused": "claim"}},
    {"id": "look", "stage": "setup", "kind": "command", "command": "look-approval", "subcommand": "marked",
     "holds": "run", "in": ["run.repo", "run.issue"],
     "on": {"unmarked": "done", "marked": "look-not-on-engine", "error": "setup", "refused": "setup"}}
  ]
}
