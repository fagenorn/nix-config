{
  "format": 1,
  "inputs": ["holder", "issue", "repo", "repo_root"],
  "stops": {
    "close-out": {"need": "owner-decision", "reenter": "read"},
    "hold": {"need": "owner-decision", "reenter": "read"},
    "code-unmet": {"need": "owner-decision", "reenter": "read"}
  },
  "steps": [
    {"id": "read", "stage": "closing out", "kind": "command", "command": "closing", "subcommand": "read", "holds": "live", "in": ["run.repo_root", "run.issue", "run.repo"], "on": {"merged": "hold-facts", "unmerged": "close-out", "error": "close-out", "refused": "close-out"}},
    {"id": "hold-facts", "stage": "closing out", "kind": "command", "command": "closing", "subcommand": "hold-facts", "holds": "live", "in": ["run.repo_root", "run.repo", "run.issue", "read.pr", "read.merge_commit"], "on": {"closes": "remove", "open": "hold-look", "bad-kinds": "close-out", "absent-merge": "hold", "error": "hold", "refused": "hold"}},
    {"id": "hold-look", "stage": "closing out", "kind": "command", "command": "closing", "subcommand": "hold-look", "holds": "live", "in": ["run.repo", "run.issue", "read.pr", "hold-facts.pr_head", "read.merge_commit", "hold-facts.posted"], "on": {"clear": "hold-draft", "stale": "hold", "error": "hold", "refused": "hold"}},
    {"id": "hold-draft", "stage": "closing out", "kind": "agent", "role": "reviewer", "prompt": "hold-draft.md", "reply": "hold-draft.reply.json", "outcome_from": "verdict", "holds": "run", "in": ["run.issue", "read.merge_commit", "hold-facts.open", "hold-facts.verification", "hold-look.answered"], "on": {"drafted": "hold-gate", "blocked": "hold", "no-reply": "hold", "out-of-bounds": "hold"}},
    {"id": "hold-gate", "stage": "closing out", "kind": "command", "command": "closing", "subcommand": "hold-gate", "holds": "live", "in": ["run.repo_root", "run.issue", "read.merge_commit", "hold-facts.criteria", "hold-facts.posted", "hold-facts.blocks", "hold-look.answered", "hold-draft.written"], "on": {"ready": "regrade", "missing-checks": "hold", "human-checks": "hold", "unattended": "hold", "owner-checks": "hold", "script-checks": "hold", "note-checks": "hold", "error": "hold", "refused": "hold"}},
    {"id": "regrade", "stage": "closing out", "kind": "agent", "role": "reviewer-lite", "prompt": "hold-regrade.md", "reply": "hold-regrade.reply.json", "outcome_from": "verdict", "holds": "run", "in": ["run.issue", "read.pr", "read.merge_commit", "hold-facts.criteria"], "on": {"met": "graded", "unmet": "code-unmet", "no-reply": "hold", "out-of-bounds": "hold"}},
    {"id": "graded", "stage": "closing out", "kind": "command", "command": "closing", "subcommand": "hold-graded", "holds": "live", "in": ["regrade.verdict", "regrade.code_unmet", "regrade.acceptance"], "on": {"met": "hold-lint", "unmet": "code-unmet", "error": "hold", "refused": "hold"}},
    {"id": "hold-lint", "stage": "closing out", "kind": "command", "command": "closing", "subcommand": "hold-lint", "holds": "live", "in": ["run.repo_root", "run.repo", "run.issue", "hold-facts.pr_head", "hold-facts.pr_branch", "hold-facts.workflows", "hold-facts.blocks", "hold-look.answered", "hold-gate.block", "hold-gate.split"], "on": {"valid": "split", "invalid": "hold", "error": "hold", "refused": "hold"}},
    {"id": "split", "stage": "closing out", "kind": "command", "command": "closing", "subcommand": "hold-split", "holds": "live", "mutates": true, "check": {"command": "closing", "subcommand": "hold-split-check"}, "in": ["run.repo", "run.issue", "read.pr", "read.merge_commit", "hold-gate.split"], "on": {"split": "hold-post", "none": "hold-post", "error": "hold", "refused": "hold"}},
    {"id": "hold-post", "stage": "closing out", "kind": "command", "command": "closing", "subcommand": "hold-post", "holds": "live", "mutates": true, "check": {"command": "closing", "subcommand": "hold-posted"}, "in": ["run.repo", "run.issue", "read.pr", "read.merge_commit", "hold-facts.criteria", "hold-look.answered", "hold-gate.block", "split.children"], "on": {"posted": "hold-label", "closed": "once-run", "error": "hold", "refused": "hold"}},
    {"id": "hold-label", "stage": "closing out", "kind": "command", "command": "closing", "subcommand": "hold-label", "holds": "live", "mutates": true, "check": {"command": "closing", "subcommand": "hold-labelled"}, "in": ["run.repo", "run.issue"], "on": {"labelled": "once-run", "error": "hold", "refused": "hold"}},
    {"id": "once-run", "stage": "closing out", "kind": "command", "command": "closing", "subcommand": "hold-run", "holds": "live", "in": ["run.repo", "run.issue", "run.holder", "hold-post.verdict", "split.children"], "on": {"ran": "remove", "failed": "hold", "error": "hold", "refused": "hold"}},
    {"id": "remove", "stage": "closing out", "kind": "command", "command": "closing", "subcommand": "worktree", "holds": "live", "in": ["run.repo_root", "read.worktree_path"], "on": {"removed": "forward", "dirty": "close-out", "error": "close-out", "refused": "close-out"}},
    {"id": "forward", "stage": "closing out", "kind": "command", "command": "closing", "subcommand": "forward", "holds": "live", "in": ["run.repo_root", "read.integration_branch"], "on": {"forwarded": "delete", "skipped": "delete", "error": "close-out", "refused": "close-out"}},
    {"id": "delete", "stage": "closing out", "kind": "command", "command": "branch-delete", "holds": "run", "in": ["run.repo_root", "read.branch"], "on": {"ok": "gone", "failed": "gone", "refused": "close-out"}},
    {"id": "gone", "stage": "closing out", "kind": "command", "command": "closing", "subcommand": "branch", "holds": "live", "in": ["run.repo_root", "read.branch"], "on": {"gone": "release", "kept": "close-out", "error": "close-out", "refused": "close-out"}},
    {"id": "release", "stage": "closing out", "kind": "command", "command": "forge-claim", "subcommand": "release", "holds": "live", "in": ["run.repo", "run.issue", "run.holder"], "on": {"released": "close", "not_held": "close-out", "error": "close-out", "refused": "close-out"}},
    {"id": "close", "stage": "closing out", "kind": "command", "command": "closing", "subcommand": "issue", "holds": "live", "in": ["run.repo", "run.issue", "hold-facts.closes"], "on": {"closed": "done", "open-criteria": "done", "error": "close-out", "refused": "close-out"}}
  ]
}
