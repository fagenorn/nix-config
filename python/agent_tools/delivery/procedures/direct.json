{
  "format": 1,
  "keep_alive": {"command": "forge-claim", "subcommand": "renew", "in": ["run.repo", "run.issue", "run.holder"]},
  "inputs": ["holder", "issue", "repo", "repo_root"],
  "stops": {
    "setup": {"need": "owner-decision", "reenter": "preflight"},
    "claim-lost": {"need": "owner-decision", "reenter": "preflight"},
    "ineligible": {"need": "owner-decision", "reenter": "preflight"},
    "task": {"need": "owner-decision", "reenter": "implement"},
    "direct-review": {"need": "owner-decision", "reenter": "implemented"},
    "direct-fix": {"need": "owner-decision", "reenter": "implemented"},
    "codex-unavailable": {"need": "retry", "reenter": "implemented"},
    "revert-check-unavailable": {"need": "retry", "reenter": "revert-check"}
  },
  "steps": [
    {"id": "preflight", "stage": "building", "kind": "command", "command": "issue-setup", "subcommand": "preflight", "holds": "live",
     "in": ["run.repo_root", "run.issue"],
     "on": {"clear": "implement", "closed": "setup", "parked": "setup", "duplicate": "setup", "open-pr": "setup", "error": "setup", "refused": "setup"}},
    {"id": "implement", "stage": "building", "kind": "agent", "role": "implementer", "prompt": "direct-implement.md", "reply": "direct-implement.reply.json", "outcome_from": "status", "holds": "run", "mutates": true,
     "in": ["run.issue", "run.repo", "preflight.issue_text", "preflight.worktree_path", "preflight.branch", "preflight.integration_branch"],
     "on": {"done": "revert-check", "blocked": "revert-check", "no-reply": "task", "out-of-bounds": "task"}},
    {"id": "revert-check", "stage": "final review", "kind": "command", "command": "revert-check", "holds": "head",
     "in": ["preflight.worktree_path", "preflight.integration_branch"],
     "on": {"ok": "implemented", "refused": "revert-check-unavailable", "out-of-bounds": "revert-check-unavailable"}},
    {"id": "implemented", "stage": "building", "kind": "decide", "grader": "direct-implemented", "holds": "run",
     "in": ["implement.ineligible", "implement.status", "implement.start_head", "implement.commit", "implement.acceptance", "implement.sensitive"],
     "on": {"ineligible": "ineligible", "task": "task", "lite": "lite-group", "full": "full-group"}},
    {"id": "lite-group", "stage": "final review", "kind": "group", "holds": "run", "max_visits": 2,
     "members": [{"step": "lite-review", "pass": ["pass", "findings"]}, {"step": "lite-independent", "pass": ["pass", "findings", "none"]}],
     "on": {"pass": "lite-tally", "blocked": "lite-tally", "exhausted": "direct-review"}},
    {"id": "lite-review", "stage": "final review", "kind": "agent", "holds": "run", "role": "reviewer-lite", "max_visits": 2, "prompt": "direct-review-lite.md", "reply": "direct-review-lite.reply.json", "outcome_from": "verdict",
     "in": ["run.issue", "preflight.worktree_path", "preflight.branch", "preflight.integration_branch", "implement.acceptance", "revert-check.still_passing", "revert-check.reason"]},
    {"id": "lite-independent", "stage": "final review", "kind": "command", "holds": "run", "command": "independent-review", "subcommand": "code",
     "in": ["run.repo_root", "run.issue", "preflight.worktree_path", "preflight.branch", "preflight.integration_branch", "implement.acceptance"]},
    {"id": "full-group", "stage": "final review", "kind": "group", "holds": "run", "max_visits": 2,
     "members": [{"step": "full-review", "pass": ["pass", "findings"]}, {"step": "full-independent", "pass": ["pass", "findings", "none"]}],
     "on": {"pass": "full-tally", "blocked": "full-tally", "exhausted": "direct-review"}},
    {"id": "full-review", "stage": "final review", "kind": "agent", "holds": "run", "role": "reviewer", "max_visits": 2, "prompt": "direct-review.md", "reply": "direct-review.reply.json", "outcome_from": "verdict",
     "in": ["run.issue", "preflight.worktree_path", "preflight.branch", "preflight.integration_branch", "implement.acceptance", "revert-check.still_passing", "revert-check.reason"]},
    {"id": "full-independent", "stage": "final review", "kind": "command", "holds": "run", "command": "independent-review", "subcommand": "code",
     "in": ["run.repo_root", "run.issue", "preflight.worktree_path", "preflight.branch", "preflight.integration_branch", "implement.acceptance"]},
    {"id": "lite-tally", "stage": "final review", "kind": "decide", "holds": "run", "grader": "direct-lite-tally", "max_visits": 2,
     "in": ["lite-review.verdict", "lite-review.findings", "lite-review.escalate", "lite-review.acceptance", "lite-independent.verdict", "lite-independent.findings", "implement.acceptance"],
     "on": {"no-review": "direct-review", "unusable": "lite-group", "escalate": "escalated", "codex-unavailable": "codex-unavailable", "findings": "lite-fix", "clean": "done", "exhausted": "direct-review"}},
    {"id": "escalated", "stage": "final review", "kind": "agent", "holds": "run", "role": "reviewer", "max_visits": 2, "prompt": "direct-review.md", "reply": "direct-review.reply.json", "outcome_from": "verdict",
     "in": ["run.issue", "preflight.worktree_path", "preflight.branch", "preflight.integration_branch", "implement.acceptance", "revert-check.still_passing", "revert-check.reason"],
     "on": {"pass": "escalated-tally", "findings": "escalated-tally", "no-reply": "direct-review", "out-of-bounds": "direct-review", "exhausted": "direct-review"}},
    {"id": "escalated-tally", "stage": "final review", "kind": "decide", "holds": "run", "grader": "direct-escalated-tally", "max_visits": 2,
     "in": ["escalated.verdict", "escalated.findings", "escalated.acceptance", "lite-independent.verdict", "lite-independent.findings", "implement.acceptance"],
     "on": {"unusable": "escalated", "codex-unavailable": "codex-unavailable", "findings": "escalated-fix", "clean": "done", "exhausted": "direct-review"}},
    {"id": "full-tally", "stage": "final review", "kind": "decide", "holds": "run", "grader": "direct-full-tally", "max_visits": 2,
     "in": ["full-review.verdict", "full-review.findings", "full-review.acceptance", "full-independent.verdict", "full-independent.findings", "implement.acceptance"],
     "on": {"no-review": "direct-review", "unusable": "full-group", "codex-unavailable": "codex-unavailable", "findings": "full-fix", "clean": "done", "exhausted": "direct-review"}},
    {"id": "lite-fix", "stage": "final review", "kind": "agent", "holds": "run", "role": "implementer", "mutates": true, "prompt": "direct-fix-lite.md", "reply": "direct-fix.reply.json", "outcome_from": "status",
     "in": ["run.issue", "preflight.worktree_path", "preflight.branch", "preflight.integration_branch", "implement.acceptance", "lite-review.findings", "lite-review.acceptance", "lite-independent.findings"],
     "on": {"done": "lite-fixed", "blocked": "lite-fixed", "no-reply": "direct-fix", "out-of-bounds": "direct-fix"}},
    {"id": "escalated-fix", "stage": "final review", "kind": "agent", "holds": "run", "role": "implementer", "mutates": true, "prompt": "direct-fix-escalated.md", "reply": "direct-fix.reply.json", "outcome_from": "status",
     "in": ["run.issue", "preflight.worktree_path", "preflight.branch", "preflight.integration_branch", "implement.acceptance", "escalated.findings", "escalated.acceptance", "lite-independent.findings"],
     "on": {"done": "escalated-fixed", "blocked": "escalated-fixed", "no-reply": "direct-fix", "out-of-bounds": "direct-fix"}},
    {"id": "full-fix", "stage": "final review", "kind": "agent", "holds": "run", "role": "implementer", "mutates": true, "prompt": "direct-fix-full.md", "reply": "direct-fix.reply.json", "outcome_from": "status",
     "in": ["run.issue", "preflight.worktree_path", "preflight.branch", "preflight.integration_branch", "implement.acceptance", "full-review.findings", "full-review.acceptance", "full-independent.findings"],
     "on": {"done": "full-fixed", "blocked": "full-fixed", "no-reply": "direct-fix", "out-of-bounds": "direct-fix"}},
    {"id": "lite-fixed", "stage": "final review", "kind": "decide", "holds": "run", "grader": "direct-fixed",
     "in": ["lite-fix.status", "lite-fix.start_head", "lite-fix.commit"],
     "on": {"done": "lite-revert-check", "not-done": "direct-fix"}},
    {"id": "lite-revert-check", "stage": "final review", "kind": "command", "command": "revert-check", "holds": "head",
     "in": ["preflight.worktree_path", "preflight.integration_branch"],
     "on": {"ok": "lite-rereview", "refused": "revert-check-unavailable", "out-of-bounds": "revert-check-unavailable"}},
    {"id": "escalated-fixed", "stage": "final review", "kind": "decide", "holds": "run", "grader": "direct-fixed",
     "in": ["escalated-fix.status", "escalated-fix.start_head", "escalated-fix.commit"],
     "on": {"done": "escalated-revert-check", "not-done": "direct-fix"}},
    {"id": "escalated-revert-check", "stage": "final review", "kind": "command", "command": "revert-check", "holds": "head",
     "in": ["preflight.worktree_path", "preflight.integration_branch"],
     "on": {"ok": "escalated-rereview", "refused": "revert-check-unavailable", "out-of-bounds": "revert-check-unavailable"}},
    {"id": "full-fixed", "stage": "final review", "kind": "decide", "holds": "run", "grader": "direct-fixed",
     "in": ["full-fix.status", "full-fix.start_head", "full-fix.commit"],
     "on": {"done": "full-revert-check", "not-done": "direct-fix"}},
    {"id": "full-revert-check", "stage": "final review", "kind": "command", "command": "revert-check", "holds": "head",
     "in": ["preflight.worktree_path", "preflight.integration_branch"],
     "on": {"ok": "full-rereview", "refused": "revert-check-unavailable", "out-of-bounds": "revert-check-unavailable"}},
    {"id": "lite-rereview", "stage": "final review", "kind": "agent", "holds": "run", "role": "reviewer-lite", "max_visits": 2, "prompt": "direct-rereview-lite.md", "reply": "direct-rereview.reply.json", "outcome_from": "verdict",
     "in": ["lite-fix.start_head", "lite-fix.commit", "lite-fix.notes", "implement.acceptance", "lite-review.findings", "lite-review.acceptance", "lite-independent.findings", "lite-fix.declines", "lite-revert-check.still_passing", "lite-revert-check.reason"],
     "on": {"pass": "lite-settled", "findings": "lite-settled", "no-reply": "direct-review", "out-of-bounds": "direct-review", "exhausted": "direct-review"}},
    {"id": "escalated-rereview", "stage": "final review", "kind": "agent", "holds": "run", "role": "reviewer-lite", "max_visits": 2, "prompt": "direct-rereview-escalated.md", "reply": "direct-rereview.reply.json", "outcome_from": "verdict",
     "in": ["escalated-fix.start_head", "escalated-fix.commit", "escalated-fix.notes", "implement.acceptance", "escalated.findings", "escalated.acceptance", "lite-independent.findings", "escalated-fix.declines", "escalated-revert-check.still_passing", "escalated-revert-check.reason"],
     "on": {"pass": "escalated-settled", "findings": "escalated-settled", "no-reply": "direct-review", "out-of-bounds": "direct-review", "exhausted": "direct-review"}},
    {"id": "full-rereview", "stage": "final review", "kind": "agent", "holds": "run", "role": "reviewer-lite", "max_visits": 2, "prompt": "direct-rereview-full.md", "reply": "direct-rereview.reply.json", "outcome_from": "verdict",
     "in": ["full-fix.start_head", "full-fix.commit", "full-fix.notes", "implement.acceptance", "full-review.findings", "full-review.acceptance", "full-independent.findings", "full-fix.declines", "full-revert-check.still_passing", "full-revert-check.reason"],
     "on": {"pass": "full-settled", "findings": "full-settled", "no-reply": "direct-review", "out-of-bounds": "direct-review", "exhausted": "direct-review"}},
    {"id": "lite-settled", "stage": "final review", "kind": "decide", "holds": "run", "grader": "direct-settled", "max_visits": 2,
     "in": ["lite-rereview.verdict", "lite-rereview.findings"],
     "on": {"clean": "done", "findings": "direct-review", "unusable": "lite-rereview", "exhausted": "direct-review"}},
    {"id": "escalated-settled", "stage": "final review", "kind": "decide", "holds": "run", "grader": "direct-settled", "max_visits": 2,
     "in": ["escalated-rereview.verdict", "escalated-rereview.findings"],
     "on": {"clean": "done", "findings": "direct-review", "unusable": "escalated-rereview", "exhausted": "direct-review"}},
    {"id": "full-settled", "stage": "final review", "kind": "decide", "holds": "run", "grader": "direct-settled", "max_visits": 2,
     "in": ["full-rereview.verdict", "full-rereview.findings"],
     "on": {"clean": "done", "findings": "direct-review", "unusable": "full-rereview", "exhausted": "direct-review"}}
  ]
}
