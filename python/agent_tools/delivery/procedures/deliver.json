{
  "format": 1,
  "keep_alive": {"command": "forge-claim", "subcommand": "renew", "in": ["run.repo", "run.issue", "run.holder"]},
  "inputs": ["holder", "issue", "repo", "repo_root"],
  "stops": {
    "setup": {"need": "owner-decision", "reenter": "start"},
    "review-blocked": {"need": "owner-decision", "reenter": "start"},
    "claimed": {"need": "owner-decision", "reenter": "start"},
    "claim": {"need": "retry", "reenter": "start"},
    "claim-lost": {"need": "owner-decision", "reenter": "start"},
    "dirty": {"need": "owner-decision", "reenter": "start"},
    "look-not-on-engine": {"need": "nothing", "reenter": "start"},
    "plan-blocked": {"need": "owner-decision", "reenter": "plan-preflight"},
    "plan-failed": {"need": "retry", "reenter": "plan-preflight"},
    "plan-refused": {"need": "owner-decision", "reenter": "plan-preflight"},
    "plan-not-posted": {"need": "retry", "reenter": "plan-preflight"},
    "no-lane": {"need": "retry", "reenter": "issue"},
    "ineligible": {"need": "owner-decision", "reenter": "issue"},
    "task": {"need": "owner-decision", "reenter": "direct-lane"},
    "direct-review": {"need": "owner-decision", "reenter": "direct-lane"},
    "direct-fix": {"need": "owner-decision", "reenter": "direct-lane"},
    "codex-unavailable": {"need": "retry", "reenter": "direct-lane"},
    "verify": {"need": "owner-decision", "reenter": "verification"},
    "verify-unrelated": {"need": "owner-decision", "reenter": "verification"},
    "verify-fix": {"need": "owner-decision", "reenter": "verification"},
    "verify-fix-review": {"need": "owner-decision", "reenter": "verification"},
    "land": {"need": "owner-decision", "reenter": "verification"},
    "head-moved": {"need": "owner-decision", "reenter": "verification"},
    "checks": {"need": "owner-decision", "reenter": "verification"},
    "land-contended": {"need": "retry", "reenter": "verification"},
    "sync-contention": {"need": "retry", "reenter": "verification"},
    "sync": {"need": "owner-decision", "reenter": "verification"},
    "sync-review": {"need": "owner-decision", "reenter": "verification"},
    "sync-fix": {"need": "owner-decision", "reenter": "verification"},
    "checks-fix": {"need": "owner-decision", "reenter": "verification"},
    "checks-fix-review": {"need": "owner-decision", "reenter": "verification"},
    "checks-pending": {"need": "retry", "reenter": "verification"},
    "merge": {"need": "owner-decision", "reenter": "landing", "pinned": true},
    "unreleased-lock": {"need": "owner-decision", "reenter": "landing", "pinned": true},
    "close-out": {"need": "owner-decision", "reenter": "closing", "pinned": true},
    "hold": {"need": "owner-decision", "reenter": "closing", "pinned": true},
    "code-unmet": {"need": "owner-decision", "reenter": "closing", "pinned": true}
  },
  "steps": [
    {"id": "start", "stage": "setup", "kind": "call", "procedure": "setup", "holds": "run",
     "on": {"done": "issue", "setup": "setup", "review-blocked": "review-blocked", "claimed": "claimed",
            "claim": "claim", "claim-lost": "claim-lost", "dirty": "dirty",
            "look-not-on-engine": "look-not-on-engine"}},
    {"id": "issue", "stage": "setup", "kind": "command", "command": "issue-setup", "subcommand": "read",
     "holds": "run", "in": ["run.repo_root", "run.repo", "run.issue"],
     "on": {"read": "lane", "error": "no-lane", "refused": "no-lane"}},
    {"id": "lane", "stage": "setup", "kind": "decide", "grader": "lane-rule", "holds": "run",
     "in": ["issue.body", "issue.marked", "issue.lane_paths"],
     "on": {"direct": "direct-lane", "standard": "plan-preflight"}},
    {"id": "plan-preflight", "stage": "planning", "kind": "command", "command": "issue-setup", "subcommand": "preflight", "holds": "run",
     "in": ["run.repo_root", "run.issue"],
     "on": {"clear": "plan", "closed": "setup", "parked": "setup", "duplicate": "setup", "open-pr": "setup", "error": "setup", "refused": "setup"}},
    {"id": "plan", "stage": "planning", "kind": "agent", "role": "planner", "prompt": "plan.md", "reply": "plan.reply.json", "outcome_from": "status", "holds": "run", "mutates": true,
     "in": ["run.issue", "run.repo", "plan-preflight.issue_text", "plan-preflight.worktree_path", "plan-preflight.branch", "plan-preflight.integration_branch"],
     "on": {"planned": "plan-read", "blocked": "plan-blocked", "no-reply": "plan-failed", "out-of-bounds": "plan-failed"}},
    {"id": "plan-read", "stage": "plan review", "kind": "command", "command": "issue-setup", "subcommand": "plan-read", "holds": "run",
     "in": ["run.issue", "plan-preflight.worktree_path", "plan.task_numbers"],
     "on": {"read": "plan-review", "error": "plan-failed", "refused": "plan-failed"}},
    {"id": "plan-review", "stage": "plan review", "kind": "agent", "role": "reviewer", "prompt": "plan-review.md", "reply": "plan-review.reply.json", "outcome_from": "verdict", "holds": "run",
     "in": ["run.issue", "run.repo", "plan-preflight.issue_text", "plan-preflight.worktree_path", "plan-preflight.branch", "plan-preflight.integration_branch", "plan-read.text"],
     "on": {"pass": "plan-graded", "findings": "plan-graded", "no-reply": "plan-failed", "out-of-bounds": "plan-failed"}},
    {"id": "plan-graded", "stage": "plan review", "kind": "decide", "grader": "plan-settled", "holds": "run",
     "in": ["plan-review.verdict", "plan-review.findings"],
     "on": {"clean": "plan-note", "findings": "plan-revise", "unusable": "plan-revise"}},
    {"id": "plan-revise", "stage": "planning", "kind": "agent", "role": "planner", "prompt": "plan-revise.md", "reply": "plan.reply.json", "outcome_from": "status", "holds": "run", "mutates": true,
     "in": ["run.issue", "run.repo", "plan-preflight.issue_text", "plan-preflight.worktree_path", "plan-preflight.branch", "plan-preflight.integration_branch", "plan-review.findings"],
     "on": {"planned": "plan-reread", "blocked": "plan-blocked", "no-reply": "plan-failed", "out-of-bounds": "plan-failed"}},
    {"id": "plan-reread", "stage": "plan review", "kind": "command", "command": "issue-setup", "subcommand": "plan-read", "holds": "run",
     "in": ["run.issue", "plan-preflight.worktree_path", "plan-revise.task_numbers"],
     "on": {"read": "plan-rereview", "error": "plan-failed", "refused": "plan-failed"}},
    {"id": "plan-rereview", "stage": "plan review", "kind": "agent", "role": "reviewer", "prompt": "plan-rereview.md", "reply": "plan-review.reply.json", "outcome_from": "verdict", "holds": "run",
     "in": ["run.issue", "run.repo", "plan-preflight.issue_text", "plan-preflight.worktree_path", "plan-preflight.branch", "plan-preflight.integration_branch", "plan-review.findings", "plan-revise.declines", "plan-reread.text"],
     "on": {"pass": "plan-regraded", "findings": "plan-regraded", "no-reply": "plan-failed", "out-of-bounds": "plan-failed"}},
    {"id": "plan-regraded", "stage": "plan review", "kind": "decide", "grader": "plan-settled", "holds": "run",
     "in": ["plan-rereview.verdict", "plan-rereview.findings"],
     "on": {"clean": "plan-revised-note", "findings": "plan-refused", "unusable": "plan-refused"}},
    {"id": "plan-note", "stage": "planning", "kind": "command", "command": "issue-setup", "subcommand": "plan-note", "holds": "run",
     "in": ["run.repo", "run.issue", "plan-preflight.worktree_path", "run.holder", "plan-read.digest", "plan.task_numbers"],
     "on": {"posted": "direct-lane", "error": "plan-not-posted", "refused": "plan-not-posted"}},
    {"id": "plan-revised-note", "stage": "planning", "kind": "command", "command": "issue-setup", "subcommand": "plan-note", "holds": "run",
     "in": ["run.repo", "run.issue", "plan-preflight.worktree_path", "run.holder", "plan-reread.digest", "plan-revise.task_numbers"],
     "on": {"posted": "direct-lane", "error": "plan-not-posted", "refused": "plan-not-posted"}},
    {"id": "direct-lane", "stage": "building", "kind": "call", "procedure": "direct", "holds": "run",
     "on": {"done": "verification", "setup": "setup", "claim-lost": "claim-lost", "ineligible": "ineligible",
            "task": "task", "direct-review": "direct-review", "direct-fix": "direct-fix",
            "codex-unavailable": "codex-unavailable"}},
    {"id": "verification", "stage": "verifying", "kind": "call", "procedure": "verify", "holds": "run",
     "on": {"done": "landing", "setup": "setup", "claim-lost": "claim-lost", "verify": "verify",
            "verify-unrelated": "verify-unrelated", "verify-fix": "verify-fix",
            "verify-fix-review": "verify-fix-review"}},
    {"id": "landing", "stage": "landing", "kind": "call", "procedure": "land", "holds": "run",
     "on": {"done": "closing", "land": "land", "claim-lost": "claim-lost", "claim": "claim",
            "head-moved": "head-moved", "checks": "checks", "checks-pending": "checks-pending",
            "checks-fix": "checks-fix", "checks-fix-review": "checks-fix-review", "sync": "sync",
            "sync-contention": "sync-contention", "sync-review": "sync-review", "sync-fix": "sync-fix",
            "land-contended": "land-contended", "merge": "merge", "unreleased-lock": "unreleased-lock"}},
    {"id": "closing", "stage": "closing out", "kind": "call", "procedure": "close-out", "holds": "run",
     "on": {"done": "done", "close-out": "close-out", "hold": "hold", "code-unmet": "code-unmet"}}
  ]
}
