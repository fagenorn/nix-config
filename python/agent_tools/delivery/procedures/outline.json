{
  "format": 1,
  "keep_alive": {"command": "forge-claim", "subcommand": "renew", "in": ["run.repo", "run.issue", "run.holder"]},
  "inputs": ["holder", "issue", "repo", "repo_root"],
  "stops": {
    "setup": {"need": "owner-decision", "reenter": "start"},
    "review-blocked": {"need": "owner-decision", "reenter": "start"},
    "claimed": {"need": "owner-decision", "reenter": "start"},
    "claim": {"need": "retry", "reenter": "start"},
    "claim-lost": {"need": "owner-decision", "reenter": "start"},
    "dirty": {"need": "owner-decision", "reenter": "start"},
    "look-not-on-engine": {"need": "nothing", "reenter": "start"},
    "plan-blocked": {"need": "owner-decision", "reenter": "plan-preflight"},
    "plan-failed": {"need": "retry", "reenter": "plan-preflight"},
    "plan-refused": {"need": "owner-decision", "reenter": "plan-preflight"},
    "plan-not-posted": {"need": "retry", "reenter": "plan-preflight"},
    "ineligible": {"need": "owner-decision", "reenter": "build"},
    "task": {"need": "owner-decision", "reenter": "build"},
    "direct-review": {"need": "owner-decision", "reenter": "build"},
    "direct-fix": {"need": "owner-decision", "reenter": "build"},
    "codex-unavailable": {"need": "retry", "reenter": "build"},
    "verify": {"need": "owner-decision", "reenter": "verification"},
    "verify-unrelated": {"need": "owner-decision", "reenter": "verification"},
    "verify-fix": {"need": "owner-decision", "reenter": "verification"},
    "verify-fix-review": {"need": "owner-decision", "reenter": "verification"},
    "land": {"need": "owner-decision", "reenter": "verification"},
    "head-moved": {"need": "owner-decision", "reenter": "verification"},
    "checks": {"need": "owner-decision", "reenter": "verification"},
    "land-contended": {"need": "retry", "reenter": "verification"},
    "sync-contention": {"need": "retry", "reenter": "verification"},
    "sync": {"need": "owner-decision", "reenter": "verification"},
    "sync-review": {"need": "owner-decision", "reenter": "verification"},
    "sync-fix": {"need": "owner-decision", "reenter": "verification"},
    "checks-fix": {"need": "owner-decision", "reenter": "verification"},
    "checks-fix-review": {"need": "owner-decision", "reenter": "verification"},
    "checks-pending": {"need": "retry", "reenter": "verification"},
    "merge": {"need": "owner-decision", "reenter": "landing", "pinned": true},
    "unreleased-lock": {"need": "owner-decision", "reenter": "landing", "pinned": true},
    "close-out": {"need": "owner-decision", "reenter": "closing", "pinned": true},
    "hold": {"need": "owner-decision", "reenter": "closing", "pinned": true},
    "code-unmet": {"need": "owner-decision", "reenter": "closing", "pinned": true}
  },
  "steps": [
    {"id": "start", "stage": "setup", "kind": "call", "procedure": "setup", "holds": "run",
     "returns": ["applies.details", "preflight.merged_refs", "preflight.branch", "preflight.worktree_path"],
     "on": {"done": "plan-preflight", "setup": "setup", "review-blocked": "review-blocked", "claimed": "claimed",
            "claim": "claim", "claim-lost": "claim-lost", "dirty": "dirty",
            "look-not-on-engine": "look-not-on-engine"}},
    {"id": "plan-preflight", "stage": "planning", "kind": "command", "command": "issue-setup", "subcommand": "plan-preflight", "holds": "run",
     "in": ["run.repo_root", "run.issue", "start.branch", "start.worktree_path"],
     "on": {"clear": "outline", "closed": "setup", "parked": "setup", "duplicate": "setup", "open-pr": "setup", "error": "setup", "refused": "setup"}},
    {"id": "outline", "stage": "planning", "kind": "agent", "role": "planner", "prompt": "outline.md", "reply": "outline.reply.json", "outcome_from": "status", "holds": "run",
     "in": ["run.issue", "run.repo", "plan-preflight.issue_text", "plan-preflight.worktree_path", "plan-preflight.branch", "plan-preflight.integration_branch",
            "start.details", "start.merged_refs", "plan-preflight.routed", "plan-preflight.route_detail"],
     "on": {"planned": "outline-mapped", "blocked": "plan-blocked", "no-reply": "plan-failed", "out-of-bounds": "plan-failed"}},
    {"id": "outline-mapped", "stage": "plan review", "kind": "decide", "grader": "outline-mapped", "holds": "run",
     "in": ["outline.slices", "outline.criteria", "plan-preflight.issue_text"],
     "on": {"mapped": "outline-proven", "unmapped": "outline-fix"}},
    {"id": "outline-proven", "stage": "plan review", "kind": "decide", "grader": "outline-proven", "holds": "run",
     "in": ["outline.slices"],
     "on": {"proven": "outline-read", "unproven": "outline-fix"}},
    {"id": "outline-fix", "stage": "planning", "kind": "agent", "role": "planner", "prompt": "outline-fix.md", "reply": "outline.reply.json", "outcome_from": "status", "holds": "run",
     "in": ["run.issue", "run.repo", "plan-preflight.issue_text", "plan-preflight.worktree_path", "plan-preflight.branch", "plan-preflight.integration_branch",
            "start.details", "start.merged_refs", "plan-preflight.routed", "plan-preflight.route_detail",
            "outline.approach", "outline.rejected", "outline.slices", "outline.criteria", "outline.risks", "outline.questions"],
     "on": {"planned": "fix-mapped", "blocked": "plan-blocked", "no-reply": "plan-failed", "out-of-bounds": "plan-failed"}},
    {"id": "fix-mapped", "stage": "plan review", "kind": "decide", "grader": "outline-mapped", "holds": "run",
     "in": ["outline-fix.slices", "outline-fix.criteria", "plan-preflight.issue_text"],
     "on": {"mapped": "fix-proven", "unmapped": "plan-refused"}},
    {"id": "fix-proven", "stage": "plan review", "kind": "decide", "grader": "outline-proven", "holds": "run",
     "in": ["outline-fix.slices"],
     "on": {"proven": "outline-read", "unproven": "plan-refused"}},
    {"id": "outline-read", "stage": "plan review", "kind": "command", "command": "issue-setup", "subcommand": "outline-read", "holds": "run",
     "in": ["run.holder", "run.issue"],
     "on": {"read": "design-review", "error": "plan-failed", "refused": "plan-failed"}},
    {"id": "design-review", "stage": "plan review", "kind": "agent", "role": "reviewer-lite", "prompt": "design-review.md", "reply": "plan-review.reply.json", "outcome_from": "verdict", "holds": "run",
     "in": ["run.issue", "run.repo", "plan-preflight.issue_text", "plan-preflight.worktree_path", "plan-preflight.branch", "plan-preflight.integration_branch", "outline-read.text"],
     "on": {"pass": "design-graded", "findings": "design-graded", "no-reply": "plan-failed", "out-of-bounds": "plan-failed"}},
    {"id": "design-graded", "stage": "plan review", "kind": "decide", "grader": "plan-settled", "holds": "run",
     "in": ["design-review.verdict", "design-review.findings"],
     "on": {"clean": "outline-note", "findings": "outline-revise", "unusable": "outline-revise"}},
    {"id": "outline-revise", "stage": "planning", "kind": "agent", "role": "planner", "prompt": "outline-revise.md", "reply": "outline.reply.json", "outcome_from": "status", "holds": "run",
     "in": ["run.issue", "run.repo", "plan-preflight.issue_text", "plan-preflight.worktree_path", "plan-preflight.branch", "plan-preflight.integration_branch",
            "start.details", "start.merged_refs", "plan-preflight.routed", "plan-preflight.route_detail",
            "outline-read.text", "design-review.findings"],
     "on": {"planned": "revise-mapped", "blocked": "plan-blocked", "no-reply": "plan-failed", "out-of-bounds": "plan-failed"}},
    {"id": "revise-mapped", "stage": "plan review", "kind": "decide", "grader": "outline-mapped", "holds": "run",
     "in": ["outline-revise.slices", "outline-revise.criteria", "plan-preflight.issue_text"],
     "on": {"mapped": "revise-proven", "unmapped": "plan-refused"}},
    {"id": "revise-proven", "stage": "plan review", "kind": "decide", "grader": "outline-proven", "holds": "run",
     "in": ["outline-revise.slices"],
     "on": {"proven": "outline-reread", "unproven": "plan-refused"}},
    {"id": "outline-reread", "stage": "plan review", "kind": "command", "command": "issue-setup", "subcommand": "outline-read", "holds": "run",
     "in": ["run.holder", "run.issue"],
     "on": {"read": "design-rereview", "error": "plan-failed", "refused": "plan-failed"}},
    {"id": "design-rereview", "stage": "plan review", "kind": "agent", "role": "reviewer-lite", "prompt": "design-rereview.md", "reply": "plan-review.reply.json", "outcome_from": "verdict", "holds": "run",
     "in": ["run.issue", "run.repo", "plan-preflight.issue_text", "plan-preflight.worktree_path", "plan-preflight.branch", "plan-preflight.integration_branch", "outline-read.text", "design-review.findings", "outline-reread.text"],
     "on": {"pass": "design-regraded", "findings": "design-regraded", "no-reply": "plan-failed", "out-of-bounds": "plan-failed"}},
    {"id": "design-regraded", "stage": "plan review", "kind": "decide", "grader": "plan-settled", "holds": "run",
     "in": ["design-rereview.verdict", "design-rereview.findings"],
     "on": {"clean": "outline-revised-note", "findings": "plan-refused", "unusable": "plan-refused"}},
    {"id": "outline-note", "stage": "planning", "kind": "command", "command": "issue-setup", "subcommand": "outline-note", "holds": "run", "mutates": true,
     "check": {"command": "issue-setup", "subcommand": "outline-note-check"},
     "in": ["run.repo", "run.issue", "run.holder", "outline-read.digest"],
     "on": {"posted": "build", "error": "plan-not-posted", "refused": "plan-not-posted"}},
    {"id": "outline-revised-note", "stage": "planning", "kind": "command", "command": "issue-setup", "subcommand": "outline-note", "holds": "run", "mutates": true,
     "check": {"command": "issue-setup", "subcommand": "outline-note-check"},
     "in": ["run.repo", "run.issue", "run.holder", "outline-reread.digest"],
     "on": {"posted": "build", "error": "plan-not-posted", "refused": "plan-not-posted"}},
    {"id": "build", "stage": "building", "kind": "call", "procedure": "outline-build", "holds": "run",
     "on": {"done": "verification", "setup": "setup", "claim-lost": "claim-lost", "ineligible": "ineligible",
            "task": "task", "direct-review": "direct-review", "direct-fix": "direct-fix",
            "codex-unavailable": "codex-unavailable"}},
    {"id": "verification", "stage": "verifying", "kind": "call", "procedure": "verify", "holds": "run",
     "on": {"done": "landing", "setup": "setup", "claim-lost": "claim-lost", "verify": "verify",
            "verify-unrelated": "verify-unrelated", "verify-fix": "verify-fix",
            "verify-fix-review": "verify-fix-review"}},
    {"id": "landing", "stage": "landing", "kind": "call", "procedure": "land", "holds": "run",
     "on": {"done": "closing", "land": "land", "claim-lost": "claim-lost", "claim": "claim",
            "head-moved": "head-moved", "checks": "checks", "checks-pending": "checks-pending",
            "checks-fix": "checks-fix", "checks-fix-review": "checks-fix-review", "sync": "sync",
            "sync-contention": "sync-contention", "sync-review": "sync-review", "sync-fix": "sync-fix",
            "land-contended": "land-contended", "merge": "merge", "unreleased-lock": "unreleased-lock"}},
    {"id": "closing", "stage": "closing out", "kind": "call", "procedure": "close-out", "holds": "run",
     "on": {"done": "done", "close-out": "close-out", "hold": "hold", "code-unmet": "code-unmet"}}
  ]
}
