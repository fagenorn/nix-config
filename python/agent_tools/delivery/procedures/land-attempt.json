{
  "format": 1,
  "keep_alive": {"command": "forge-claim", "subcommand": "renew", "in": ["run.repo", "run.issue", "run.holder"]},
  "inputs": ["holder", "issue", "repo", "repo_root"],
  "stops": {
    "land": {"need": "owner-decision", "reenter": "renew"},
    "claim-lost": {"need": "owner-decision", "reenter": "renew"},
    "claim": {"need": "retry", "reenter": "renew"},
    "head-moved": {"need": "owner-decision", "reenter": "renew"},
    "checks": {"need": "owner-decision", "reenter": "renew"},
    "checks-fix": {"need": "owner-decision", "reenter": "renew"},
    "checks-fix-review": {"need": "owner-decision", "reenter": "renew"},
    "checks-pending": {"need": "retry", "reenter": "renew"},
    "sync": {"need": "owner-decision", "reenter": "renew"},
    "sync-contention": {"need": "retry", "reenter": "renew"},
    "sync-review": {"need": "owner-decision", "reenter": "renew"},
    "sync-fix": {"need": "owner-decision", "reenter": "renew"},
    "land-contended": {"need": "retry", "reenter": "renew"},
    "merge": {"need": "owner-decision", "reenter": "renew"},
    "unreleased-lock": {"need": "owner-decision", "reenter": "renew"}
  },
  "steps": [
    {"id": "renew", "stage": "landing", "kind": "command", "command": "forge-claim", "subcommand": "renew", "holds": "live", "in": ["run.repo", "run.issue", "run.holder"], "on": {"renewed": "prepare", "not_held": "claim-lost", "error": "claim", "refused": "claim"}},
    {"id": "prepare", "stage": "landing", "kind": "command", "command": "landing", "subcommand": "prepare", "holds": "live", "in": ["run.repo_root", "run.issue", "run.repo"], "on": {"ready": "settled", "unverified": "land", "error": "land", "refused": "land"}},
    {"id": "settled", "stage": "landing", "kind": "command", "command": "closing", "subcommand": "read", "holds": "live", "in": ["run.repo_root", "run.issue", "run.repo", "prepare.head"], "on": {"merged": "done", "unmerged": "expect", "error": "expect", "refused": "expect"}},
    {"id": "expect", "stage": "landing", "kind": "command", "command": "landing", "subcommand": "head", "holds": "live", "max_visits": 12, "in": ["prepare.worktree_path"], "on": {"clean": "push", "dirty": "land", "error": "land", "refused": "land", "exhausted": "land"}},
    {"id": "push", "stage": "landing", "kind": "command", "command": "git-push", "holds": "run", "max_visits": 12, "in": ["run.repo_root", "prepare.branch"], "on": {"ok": "pushed", "failed": "pushed", "refused": "land", "exhausted": "land"}},
    {"id": "pushed", "stage": "landing", "kind": "command", "command": "landing", "subcommand": "pushed", "holds": "live", "max_visits": 12, "in": ["run.repo_root", "prepare.branch", "expect.head"], "on": {"pushed": "find-pull", "head-moved": "head-moved", "absent": "land", "error": "land", "refused": "land", "exhausted": "land"}},
    {"id": "find-pull", "stage": "landing", "kind": "command", "command": "landing", "subcommand": "pull", "holds": "live", "max_visits": 12, "in": ["run.repo", "prepare.branch", "prepare.integration_branch"], "on": {"open": "opened", "absent": "create", "error": "land", "refused": "land", "exhausted": "land"}},
    {"id": "create", "stage": "landing", "kind": "command", "command": "pr-create", "holds": "run", "max_visits": 2, "in": ["run.repo", "prepare.integration_branch", "prepare.branch", "prepare.title", "prepare.body"], "on": {"ok": "opened", "failed": "opened", "refused": "land", "exhausted": "land"}},
    {"id": "opened", "stage": "landing", "kind": "command", "command": "landing", "subcommand": "pull", "holds": "live", "max_visits": 12, "in": ["run.repo", "prepare.branch", "prepare.integration_branch"], "on": {"open": "probe", "absent": "land", "error": "land", "refused": "land", "exhausted": "land"}},
    {"id": "probe", "stage": "landing", "kind": "command", "command": "landing", "subcommand": "probe", "holds": "live", "max_visits": 12, "in": ["prepare.worktree_path", "prepare.integration_branch"], "on": {"clean": "gate", "behind": "gate", "conflicted": "resolve", "error": "land", "refused": "land", "exhausted": "land"}},
    {"id": "gate", "stage": "landing", "kind": "command", "command": "landing", "subcommand": "checks", "holds": "live", "wait": "checks", "max_visits": 12, "in": ["run.repo_root", "run.repo", "opened.pr", "expect.head"], "on": {"green": "lock", "red": "checks", "pending": "checks-pending", "moved": "head-moved", "error": "land", "refused": "land", "exhausted": "land", "out-of-bounds": "land"}},
    {"id": "lock", "stage": "landing", "kind": "command", "command": "landing", "subcommand": "lock", "holds": "live", "wait": "lock", "max_visits": 12, "in": ["run.repo", "prepare.integration_branch", "expect.head"], "on": {"held": "fresh", "contended": "land-contended", "no-pull": "head", "error": "land", "refused": "land", "exhausted": "land", "out-of-bounds": "land"}},
    {"id": "fresh", "stage": "landing", "kind": "command", "command": "landing", "subcommand": "probe", "holds": "live", "max_visits": 12, "in": ["prepare.worktree_path", "prepare.integration_branch"], "on": {"clean": "head", "behind": "lock-sync", "conflicted": "lock-sync", "error": "land", "refused": "land", "exhausted": "land"}},
    {"id": "head", "stage": "landing", "kind": "command", "command": "landing", "subcommand": "pr-head", "holds": "live", "max_visits": 12, "in": ["run.repo", "opened.pr", "expect.head"], "on": {"pushed": "recheck", "head-moved": "head-moved", "error": "land", "refused": "land", "exhausted": "land"}},
    {"id": "recheck", "stage": "landing", "kind": "command", "command": "landing", "subcommand": "held", "holds": "live", "max_visits": 12, "in": ["run.repo", "prepare.integration_branch", "expect.head"], "on": {"held": "merge-pr", "retaken": "land-contended", "contended": "land-contended", "no-pull": "land", "error": "land", "refused": "land", "exhausted": "land"}},
    {"id": "merge-pr", "stage": "landing", "kind": "command", "command": "pr-merge", "holds": "run", "max_visits": 6, "in": ["opened.pr", "run.repo", "expect.head"], "on": {"ok": "merged", "failed": "merged", "refused": "merge", "exhausted": "merge"}},
    {"id": "merged", "stage": "landing", "kind": "command", "command": "landing", "subcommand": "merged", "holds": "live", "max_visits": 6, "in": ["run.repo", "opened.pr", "expect.head"], "on": {"merged": "done", "open": "merge", "error": "merge", "refused": "merge", "exhausted": "merge"}},
    {"id": "lock-sync", "stage": "landing", "kind": "agent", "role": "implementer", "prompt": "land-sync.md", "reply": "land-sync.reply.json", "outcome_from": "status", "holds": "run", "mutates": true, "max_visits": 2, "in": ["run.issue", "prepare.worktree_path", "prepare.branch", "prepare.integration_branch", "expect.head"], "on": {"done": "merge-of", "conflicted": "resolve-unlock", "blocked": "sync", "no-reply": "sync", "out-of-bounds": "sync", "exhausted": "sync-contention"}},
    {"id": "resolve-unlock", "stage": "landing", "kind": "command", "command": "landing", "subcommand": "free", "holds": "live", "max_visits": 6, "in": ["run.repo", "prepare.integration_branch", "run.holder"], "on": {"released": "resolve", "unreleased": "unreleased-lock", "refused": "unreleased-lock", "exhausted": "sync"}},
    {"id": "resolve", "stage": "landing", "kind": "agent", "role": "implementer", "prompt": "land-resolve.md", "reply": "land-sync.reply.json", "outcome_from": "status", "holds": "run", "mutates": true, "max_visits": 4, "in": ["run.issue", "prepare.worktree_path", "prepare.branch", "prepare.integration_branch"], "on": {"done": "merge-of", "conflicted": "sync", "blocked": "sync", "no-reply": "sync", "out-of-bounds": "sync", "exhausted": "sync"}},
    {"id": "merge-of", "stage": "landing", "kind": "command", "command": "landing", "subcommand": "merge-of", "holds": "live", "max_visits": 8, "in": ["prepare.worktree_path", "prepare.integration_branch"], "on": {"clean": "expect", "review": "merge-review", "none": "sync", "error": "land", "exhausted": "sync", "refused": "land"}},
    {"id": "merge-review", "stage": "landing", "kind": "agent", "role": "reviewer", "prompt": "land-sync-review.md", "reply": "direct-rereview.reply.json", "outcome_from": "verdict", "holds": "run", "max_visits": 4, "in": ["prepare.worktree_path", "prepare.integration_branch", "merge-of.merge_commit", "merge-of.head"], "on": {"pass": "expect", "findings": "merge-fixes", "no-reply": "sync-review", "out-of-bounds": "sync-review", "exhausted": "sync-review"}},
    {"id": "merge-fixes", "stage": "landing", "kind": "command", "command": "landing", "subcommand": "sync-fixes", "holds": "live", "max_visits": 4, "in": ["run.holder"], "on": {"fix": "merge-fix", "spent": "sync-review", "error": "land", "exhausted": "sync-review", "refused": "land"}},
    {"id": "merge-fix", "stage": "landing", "kind": "agent", "role": "implementer", "prompt": "land-sync-fix.md", "reply": "direct-fix.reply.json", "outcome_from": "status", "holds": "run", "mutates": true, "max_visits": 1, "in": ["prepare.worktree_path", "prepare.integration_branch", "merge-of.merge_commit", "merge-of.head", "merge-review.findings"], "on": {"done": "merge-fixed", "blocked": "merge-fixed", "no-reply": "sync-fix", "out-of-bounds": "sync-fix", "exhausted": "sync-review"}},
    {"id": "merge-fixed", "stage": "landing", "kind": "command", "command": "landing", "subcommand": "fixed", "holds": "live", "max_visits": 1, "in": ["merge-fix.status", "merge-fix.start_head", "merge-fix.commit", "merge-fix.tests", "merge-fix.notes", "merge-of.head"], "on": {"committed": "merge-rereview", "unchanged": "merge-rereview", "untested": "sync-fix", "silent": "sync-fix", "not-done": "sync-fix", "exhausted": "sync-fix", "refused": "land"}},
    {"id": "merge-rereview", "stage": "landing", "kind": "agent", "role": "reviewer", "prompt": "land-sync-rereview.md", "reply": "direct-rereview.reply.json", "outcome_from": "verdict", "holds": "run", "max_visits": 1, "in": ["prepare.worktree_path", "merge-of.merge_commit", "merge-review.findings", "merge-fix.start_head", "merge-fix.commit", "merge-fix.notes"], "on": {"pass": "expect", "findings": "sync-review", "no-reply": "sync-review", "out-of-bounds": "sync-review", "exhausted": "sync-review"}}
  ]
}
