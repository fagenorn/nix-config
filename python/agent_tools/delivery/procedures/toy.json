{
  "format": 1,
  "keep_alive": {"command": "forge-claim", "subcommand": "renew", "in": ["run.repo", "run.issue", "run.holder"]},
  "inputs": ["holder", "issue", "range", "repo"],
  "stops": {"needs-owner": {"need": "owner-decision", "reenter": "draft"}},
  "steps": [
    {"id": "scope", "stage": "setup", "kind": "command", "command": "diff-scope",
     "in": ["run.range"], "on": {"ok": "draft", "failed": "needs-owner"}},
    {"id": "draft", "stage": "building", "kind": "agent", "role": "implementer",
     "prompt": "toy-draft.md", "reply": "toy-draft.reply.json", "outcome_from": "status",
     "in": ["run.issue"], "max_visits": 3, "mutates": true,
     "on": {"drafted": "review", "stuck": "needs-owner", "exhausted": "needs-owner"}},
    {"id": "review", "stage": "final review", "kind": "group",
     "members": [{"step": "review-a", "pass": ["approve"]}, {"step": "review-b", "pass": ["approve"]}],
     "max_visits": 3, "on": {"pass": "tally", "blocked": "tally", "exhausted": "needs-owner"}},
    {"id": "review-a", "stage": "final review", "kind": "agent", "role": "reviewer",
     "prompt": "toy-review.md", "reply": "toy-review.reply.json", "outcome_from": "verdict",
     "in": ["draft.summary"], "max_visits": 3},
    {"id": "review-b", "stage": "final review", "kind": "agent", "role": "reviewer-lite",
     "prompt": "toy-review-lite.md", "reply": "toy-review.reply.json", "outcome_from": "verdict",
     "in": ["draft.summary"], "max_visits": 3},
    {"id": "tally", "stage": "final review", "kind": "decide", "grader": "toy-tally",
     "in": ["review-a.verdict", "review-b.verdict"], "max_visits": 3,
     "on": {"accept": "children", "revise": "draft", "exhausted": "needs-owner"}},
    {"id": "children", "stage": "landing", "kind": "call", "procedure": "toy-child",
     "in": ["draft.items"], "each": "draft.items", "parallel": 2, "mutates": true,
     "on": {"done": "done", "child-stop": "needs-owner"}}
  ]
}
