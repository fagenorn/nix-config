{
  "format": 1,
  "keep_alive": {"command": "forge-claim", "subcommand": "renew", "in": ["run.repo", "run.issue", "run.holder"]},
  "inputs": ["holder", "issue", "item", "repo"],
  "stops": {"child-stop": {"need": "retry", "reenter": "claim"}},
  "steps": [
    {"id": "claim", "stage": "building", "kind": "command", "command": "forge-claim", "subcommand": "status",
     "holds": "live", "in": ["run.repo", "run.issue", "run.holder"], "mutates": true,
     "check": {"command": "forge-claim", "subcommand": "status"},
     "on": {"free": "done", "held_by": "done", "stale": "child-stop", "error": "child-stop"}}
  ]
}
