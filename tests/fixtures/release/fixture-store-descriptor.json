        "reversible_no_incremental_spend"
      ],
      "recovery_capable": false,
      "candidate_members": []
    },
    "overwrite": {
      "mode": "materialize",
      "support": "supported",
      "inspect": "supported",
      "reason": null,
      "mutability": "in_place",
      "config_schema_version": 1,
      "config_schema": {
        "members": {},
        "required": []
      },
      "effects": [
        "reversible_no_incremental_spend"
      ],
      "recovery_capable": false,
      "candidate_members": []
    },
    "repoint": {
      "mode": null,
      "support": "supported",
      "inspect": "supported",
      "reason": null,
