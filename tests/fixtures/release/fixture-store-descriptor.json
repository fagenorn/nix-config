{
  "name": "fixture-store",
  "adapter_contract_version": "1.4.0",
  "operations": {
    "publish": {
      "mode": "materialize",
      "support": "supported",
      "inspect": "supported",
      "reason": null,
      "mutability": "create_if_absent",
      "config_schema_version": 1,
      "config_schema": {
        "members": {
          "bucket": "string"
        },
        "required": [
          "bucket"
        ]
      },
      "effects": [
        "irreversible",
        "reversible_no_incremental_spend"
      ],
      "recovery_capable": false,
      "candidate_members": []
    },
    "promote": {
