      "config_schema_version": 1,
      "config_schema": {
        "members": {},
        "required": []
      },
      "effects": [
        "reversible_no_incremental_spend"
      ],
      "recovery_capable": true,
      "candidate_members": []
    },
    "retain": {
      "mode": null,
      "support": "supported",
      "inspect": "supported",
      "reason": null,
      "mutability": "create_if_absent",
      "config_schema_version": 1,
      "config_schema": {
        "members": {},
        "required": []
      },
      "effects": [
        "reversible_no_incremental_spend"
      ],
      "recovery_capable": true,
      "candidate_members": []
