#!/bin/sh
# Verify check for issue 893: a manager gone while its sprint has work is brought back.
# `start` states a marked goal, approves its brief, waits for "on track", stops the manager and
# waits for the same session to be listed again, removes it and waits for a new one; `timing`
# reports how long the stopped manager took to come back.
# Exit 0 met, 1 not met, 75 not yet. Run from the repository root at the block's commit.
PYTHONPATH=python exec python3 -m agent_tools.console.revive_check "$@"
