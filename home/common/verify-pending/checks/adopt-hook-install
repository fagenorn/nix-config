#!/bin/sh
# Verify check: an adoption installed a project's missing git hooks and its commit ran them.
# verify-pending runs it from the repository root at the commit the block names, so
# `python` below is that commit's agent_tools source. Exit 0 met, 1 not met, 75 not yet.
PYTHONPATH=python exec python3 -m agent_tools.verification.adopt_hook_check "$@"
