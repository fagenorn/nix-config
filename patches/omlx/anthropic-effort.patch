+def _merge_anthropic_chat_template_kwargs(request, settings, entry) -> dict:
+    """Resolve Claude effort while retaining explicit and forced template keys."""
+    effort = request.output_config.effort if request.output_config else None
+    # Qwen3.8 names its highest tier xhigh rather than high or max. Use the
+    # discovered template contract so aliases and fallback models behave alike.
+    supported_efforts = getattr(entry, "reasoning_efforts", None) or []
+    is_qwen_effort_set = (
+        getattr(entry, "config_model_type", None) == "qwen4_exp"
+        and {"low", "medium", "xhigh"}.issubset(supported_efforts)
+    )
+    if is_qwen_effort_set and effort in ("high", "max") and effort not in supported_efforts:
+        effort = "xhigh"
+    merged = merge_chat_template_request_kwargs(
+        settings,
+        merge_reasoning_effort_chat_template_kwargs(request.chat_template_kwargs, effort),
+    )
+    if is_qwen_effort_set and "reasoning_effort" in merged:
+        if merged["reasoning_effort"] not in supported_efforts:
+            # The generic renderer retries invalid values using the template's
+            # default, which would hide a bad override by silently using xhigh.
+            raise InvalidRequestError(
+                f"This template requires reasoning_effort from {supported_efforts}",
+                field="chat_template_kwargs.reasoning_effort",
+            )
+
+    forced_keys = forced_ct_keys(settings)
+    if request.thinking and "enable_thinking" not in forced_keys:
+        thinking_type = request.thinking.type
+        if thinking_type in ("enabled", "adaptive"):
+            merged["enable_thinking"] = True
+        elif thinking_type == "disabled":
+            merged["enable_thinking"] = False
+        if (
+            thinking_type == "adaptive"
+            and "thinking_mode" not in forced_keys
+            and getattr(entry, "config_model_type", None) in MINIMAX_M3_MODEL_TYPES
+        ):
+            merged.setdefault("thinking_mode", "adaptive")
+    return merged
+
+
