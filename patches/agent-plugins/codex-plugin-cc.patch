@@ -0,0 +1,111 @@
+import fs from "node:fs";
+import path from "node:path";
+import test from "node:test";
+import assert from "node:assert/strict";
+import { spawn } from "node:child_process";
+
+import { initGitRepo, makeTempDir } from "./helpers.mjs";
+import {
+  cleanupReviewerRuntime,
+  createReviewerRuntime,
+  createWorkspaceRuntime
+} from "../plugins/codex/scripts/lib/runtime-home.mjs";
+import { listJobs, resolveStateFile } from "../plugins/codex/scripts/lib/state.mjs";
+
+async function withPluginEnvironment(operation) {
+  const previous = {
+    CODEX_HOME: process.env.CODEX_HOME,
+    CLAUDE_PLUGIN_DATA: process.env.CLAUDE_PLUGIN_DATA,
+    CODEX_COMPANION_CANONICAL_CODEX_HOME: process.env.CODEX_COMPANION_CANONICAL_CODEX_HOME
+  };
+  const canonicalHome = makeTempDir();
+  const pluginData = makeTempDir();
+  process.env.CODEX_HOME = canonicalHome;
+  process.env.CLAUDE_PLUGIN_DATA = pluginData;
+  delete process.env.CODEX_COMPANION_CANONICAL_CODEX_HOME;
+  try {
+    return await operation({ canonicalHome, pluginData });
+  } finally {
+    for (const [name, value] of Object.entries(previous)) {
+      if (value == null) {
+        delete process.env[name];
+      } else {
+        process.env[name] = value;
+      }
+    }
+  }
+}
+
+function waitForChild(child) {
+  return new Promise((resolve, reject) => {
+    let stderr = "";
+    child.stderr.on("data", (chunk) => {
+      stderr += chunk;
+    });
+    child.on("error", reject);
+    child.on("exit", (code) => {
+      if (code === 0) {
+        resolve();
+      } else {
+        reject(new Error(stderr || `child exited ${code}`));
+      }
+    });
+  });
+}
+
+test("workspace and reviewer runtimes isolate every mutable Codex path", async () => {
+  await withPluginEnvironment(({ canonicalHome }) => {
+    const workspace = makeTempDir();
+    initGitRepo(workspace);
+    fs.writeFileSync(path.join(canonicalHome, "auth.json"), "{\"token\":\"shared\"}\n");
+    fs.writeFileSync(path.join(canonicalHome, "config.toml"), "model = \"canonical\"\n");
+    fs.writeFileSync(path.join(canonicalHome, "hooks.json"), "{}\n");
+    fs.mkdirSync(path.join(canonicalHome, "rules"));
+
+    const persistent = createWorkspaceRuntime(workspace);
+    const persistentAgain = createWorkspaceRuntime(workspace);
+    assert.equal(persistent.runtimeHome, persistentAgain.runtimeHome);
+    assert.equal(fs.lstatSync(path.join(persistent.runtimeHome, "auth.json")).isSymbolicLink(), true);
+    assert.equal(fs.lstatSync(path.join(persistent.runtimeHome, "rules")).isSymbolicLink(), true);
+    assert.equal(fs.lstatSync(path.join(persistent.runtimeHome, "config.toml")).isSymbolicLink(), false);
+
+    const first = createReviewerRuntime(workspace, "review-one");
+    const second = createReviewerRuntime(workspace, "review-two");
+    assert.notEqual(first.runtimeHome, second.runtimeHome);
+    assert.notEqual(first.runtimeHome, persistent.runtimeHome);
+    fs.writeFileSync(path.join(first.runtimeHome, "config.toml"), "model = \"reviewer\"\n");
+    assert.equal(fs.readFileSync(path.join(canonicalHome, "config.toml"), "utf8"), "model = \"canonical\"\n");
+    assert.equal(fs.readFileSync(path.join(second.runtimeHome, "config.toml"), "utf8"), "model = \"canonical\"\n");
+
+    cleanupReviewerRuntime(workspace, "review-one");
+    cleanupReviewerRuntime(workspace, "review-two");
+    assert.equal(fs.existsSync(first.runtimeHome), false);
+    assert.equal(fs.existsSync(second.runtimeHome), false);
+    assert.equal(fs.existsSync(persistent.runtimeHome), true);
+  });
+});
+
+test("concurrent jobs use independent atomic records without a shared job index", async () => {
+  await withPluginEnvironment(async ({ pluginData }) => {
+    const workspace = makeTempDir();
+    initGitRepo(workspace);
+    const stateModule = new URL("../plugins/codex/scripts/lib/state.mjs", import.meta.url).href;
+    const children = Array.from({ length: 24 }, (_, index) => {
+      const id = `parallel-${index}`;
+      const source = `import { upsertJob } from ${JSON.stringify(stateModule)}; upsertJob(${JSON.stringify(workspace)}, { id: ${JSON.stringify(id)}, status: \"running\", workspaceRoot: ${JSON.stringify(workspace)} });`;
+      return waitForChild(
+        spawn(process.execPath, ["--input-type=module", "--eval", source], {
+          env: { ...process.env, CLAUDE_PLUGIN_DATA: pluginData },
+          stdio: ["ignore", "ignore", "pipe"]
+        })
+      );
+    });
+
+    await Promise.all(children);
+    const jobs = listJobs(workspace);
+    assert.equal(jobs.length, 24);
+    assert.equal(new Set(jobs.map((job) => job.id)).size, 24);
+    const stateFile = resolveStateFile(workspace);
+    assert.equal(fs.existsSync(stateFile), false);
+  });
+});
