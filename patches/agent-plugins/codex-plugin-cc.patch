index 0000000..aff6584
--- /dev/null
+++ b/plugins/codex/scripts/lib/runtime-home.mjs
@@ -0,0 +1,120 @@
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+
+import { resolveStateDir } from "./state.mjs";
+
+export const CANONICAL_CODEX_HOME_ENV = "CODEX_COMPANION_CANONICAL_CODEX_HOME";
+const REVIEWER_RUNTIMES_DIR = "reviewer-runtimes";
+const WORKSPACE_RUNTIME_DIR = "codex-home";
+const RUNTIME_MANIFEST = ".codex-companion-runtime.json";
+const MUTABLE_CONFIG_FILES = ["config.toml", "hooks.json"];
+const STATIC_ASSETS = ["AGENTS.md", "rules", "policy", "policies", "profiles"];
+
+function atomicWriteJson(filePath, value) {
+  const temporary = `${filePath}.${process.pid}.${Math.random().toString(36).slice(2)}.tmp`;
+  fs.writeFileSync(temporary, `${JSON.stringify(value, null, 2)}\n`, { encoding: "utf8", mode: 0o600 });
+  fs.renameSync(temporary, filePath);
+}
+
+export function resolveCanonicalCodexHome(env = process.env) {
+  return path.resolve(env[CANONICAL_CODEX_HOME_ENV] || env.CODEX_HOME || path.join(os.homedir(), ".codex"));
+}
+
+function linkIfPresent(source, destination) {
+  if (!fs.existsSync(source) || fs.existsSync(destination)) {
+    return;
+  }
+  const type = fs.statSync(source).isDirectory() && process.platform === "win32" ? "junction" : undefined;
+  fs.symlinkSync(source, destination, type);
+}
+
+function copyPrivateIfPresent(source, destination) {
+  if (!fs.existsSync(source) || fs.existsSync(destination)) {
+    return;
+  }
+  fs.copyFileSync(source, destination);
+  fs.chmodSync(destination, 0o600);
+}
+
+function seedRuntimeHome(runtimeHome, canonicalHome, kind) {
+  fs.mkdirSync(runtimeHome, { recursive: true, mode: 0o700 });
+
+  linkIfPresent(path.join(canonicalHome, "auth.json"), path.join(runtimeHome, "auth.json"));
+  for (const name of MUTABLE_CONFIG_FILES) {
+    copyPrivateIfPresent(path.join(canonicalHome, name), path.join(runtimeHome, name));
+  }
+  for (const name of STATIC_ASSETS) {
+    linkIfPresent(path.join(canonicalHome, name), path.join(runtimeHome, name));
+  }
+
+  atomicWriteJson(path.join(runtimeHome, RUNTIME_MANIFEST), {
+    version: 1,
+    kind,
+    canonicalHome,
+    runtimeHome
+  });
+  return runtimeHome;
+}
+
+function buildRuntimeEnv(runtimeHome, canonicalHome, env) {
+  return {
+    ...env,
+    CODEX_HOME: runtimeHome,
+    [CANONICAL_CODEX_HOME_ENV]: canonicalHome
+  };
+}
+
+export function createWorkspaceRuntime(cwd, options = {}) {
+  const env = options.env ?? process.env;
+  const canonicalHome = resolveCanonicalCodexHome(env);
+  const runtimeHome = path.join(resolveStateDir(cwd), WORKSPACE_RUNTIME_DIR);
+  seedRuntimeHome(runtimeHome, canonicalHome, "workspace");
+  return { canonicalHome, runtimeHome, env: buildRuntimeEnv(runtimeHome, canonicalHome, env) };
+}
+
+function resolveReviewerRuntimeHomeInStateDir(stateDir, jobId) {
+  if (!jobId || !/^[a-zA-Z0-9._-]+$/.test(jobId)) {
+    throw new Error("A safe reviewer job id is required for an isolated Codex runtime.");
+  }
+  return path.join(stateDir, REVIEWER_RUNTIMES_DIR, jobId);
+}
+
+export function resolveReviewerRuntimeHome(cwd, jobId) {
+  return resolveReviewerRuntimeHomeInStateDir(resolveStateDir(cwd), jobId);
+}
+
+export function createReviewerRuntime(cwd, jobId, options = {}) {
+  const env = options.env ?? process.env;
+  const canonicalHome = resolveCanonicalCodexHome(env);
+  const runtimeHome = resolveReviewerRuntimeHome(cwd, jobId);
+  if (fs.existsSync(runtimeHome)) {
+    fs.rmSync(runtimeHome, { recursive: true, force: true });
+  }
+  seedRuntimeHome(runtimeHome, canonicalHome, "reviewer");
+  return { canonicalHome, runtimeHome, env: buildRuntimeEnv(runtimeHome, canonicalHome, env) };
+}
+
+// The state-dir variant carries the body, and the cwd variant delegates through
+// resolveStateDir — the same split state.mjs uses for updateJobRecordInStateDir
+// and pruneJobRecordsInStateDir, and for the same reason. resolveStateDir hashes
+// the *realpath* of a job's workspaceRoot and falls back to the literal path
+// when that fails, so for a worktree moved or deleted since the record was
+// written it names a different state dir than the one actually holding the
+// record. A caller that already knows the owning state dir — the SessionEnd hook
+// walks them — must aim there, or `rmSync` silently no-ops on an empty path and
+// the real runtime dir leaks for good now that the record survives to point at
+// it. The owned-root guard stays on this shared path, so both variants apply it.
+export function cleanupReviewerRuntimeInStateDir(stateDir, jobId) {
+  const runtimeHome = resolveReviewerRuntimeHomeInStateDir(stateDir, jobId);
+  const runtimeRoot = path.join(stateDir, REVIEWER_RUNTIMES_DIR);
