+// A peer that takes the broker's FIN and never answers with one of its own:
+// allowHalfOpen keeps this socket's write side open when its read side ends, so
+// the connection stays established from the server's side and a server.close()
+// that waits for every connection to close waits for this one forever. That is
+// what an unresponsive client looks like to a broker -- no sleep stands in for
+// it. The connect itself is bounded so a broker that never accepts fails the
+// test instead of hanging it.
+function connectHalfOpenPeer(t, endpoint) {
+  const target = parseBrokerEndpoint(endpoint);
+  return new Promise((resolve, reject) => {
+    const socket = net.connect({ path: target.path, allowHalfOpen: true });
+    const timer = setTimeout(() => {
+      socket.destroy();
+      reject(new Error("Timed out connecting to the broker endpoint."));
+    }, 10000);
+    socket.once("connect", () => {
+      clearTimeout(timer);
+      // The broker drops this connection unilaterally, which surfaces here as
+      // ECONNRESET; without a handler that would throw in the test process.
+      socket.on("error", () => {});
+      t.after(() => socket.destroy());
+      resolve(socket);
+    });
+    socket.once("error", (error) => {
+      clearTimeout(timer);
+      reject(error);
+    });
+  });
+}
