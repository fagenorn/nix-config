+// Answers the reuse gate's 150 ms connect probe and nothing else: the gate only
+// asks whether something is listening, so a bare accept-and-close server is a
+// faithful stand-in for a ready broker without a codex app-server behind it.
+function startStubBroker(t, sessionDir, endpoint) {
+  const target = parseBrokerEndpoint(endpoint);
+  const source = `import net from "node:net"; net.createServer((socket) => socket.end()).listen(${JSON.stringify(
+    target.path
+  )}); setInterval(() => {}, 1000);`;
+  const child = spawn(process.execPath, ["--input-type=module", "--eval", source], {
+    detached: true,
+    stdio: "ignore"
+  });
+  child.unref();
+  // A real broker writes this file at startup and unlinks it on shutdown, so a
+  // stand-in for a *ready* broker has to have one: a record-sourced pid is
+  // signalled only while its pid file still names it, and without the file this
+  // stub would look like a broker that had already exited cleanly.
+  fs.writeFileSync(path.join(sessionDir, "broker.pid"), `${child.pid}\n`, "utf8");
+  t.after(() => killGroup(child.pid, "SIGKILL"));
+  return child;
+}
