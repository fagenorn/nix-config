+  fs.writeFileSync(stalePidFile, `${sleeper.pid}\n`, "utf8");
+  saveBrokerSession(workspace, {
+    endpoint: `unix:${path.join(staleDir, "broker.sock")}`,
+    pidFile: stalePidFile,
