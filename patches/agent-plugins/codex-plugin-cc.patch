+// A codex app-server that answers `initialize` and then refuses to die: it
+// ignores SIGTERM and stays alive after its stdin is ended, so the broker's
+// appClient.close() -- which ends stdin, SIGTERMs 50 ms later and then awaits the
+// child's exit -- never completes on its own. installFakeCodex has no shape for
+// "the child hangs", and this file already writes purpose-built stubs
+// (startStubBroker, the never-listens broker) for conditions the shared fixture
+// cannot express.
+function installWedgedCodex(binDir, pidReport) {
+  writeExecutable(
+    path.join(binDir, "codex"),
+    [
+      "#!/usr/bin/env node",
+      'const fs = require("node:fs");',
+      'const readline = require("node:readline");',
+      'if (process.argv[2] !== "app-server") {',
+      "  process.exit(0);",
+      "}",
+      `fs.writeFileSync(${JSON.stringify(pidReport)}, String(process.pid), "utf8");`,
+      'process.on("SIGTERM", () => {});',
+      'process.on("SIGINT", () => {});',
+      "const rl = readline.createInterface({ input: process.stdin });",
+      'rl.on("line", (line) => {',
+      "  const message = JSON.parse(line);",
+      "  if (message.id !== undefined) {",
+      '    process.stdout.write(JSON.stringify({ id: message.id, result: { userAgent: "wedged-app-server" } }) + "\\n");',
+      "  }",
+      "});",
+      "setInterval(() => {}, 1000);",
+      ""
+    ].join("\n")
+  );
+}
+
+test("a self-reaping broker whose app-server will not exit still exits and takes it with it", async (t) => {
+  const workspace = makeWorkspace();
+  const binDir = makeTempDir();
+  const pidReport = path.join(binDir, "wedged-app-server.pid");
+  installWedgedCodex(binDir, pidReport);
+  const canonicalHome = makeCanonicalHome();
+  const broker = startSupervisedBroker({
+    workspace,
+    binDir,
+    canonicalHome,
+    idleTimeoutMs: 60000,
+    superviseIntervalMs: 100
+  });
+  t.after(() => killGroup(broker.child.pid, "SIGKILL"));
+
+  assert.equal(await waitForBrokerEndpoint(broker.endpoint, 10000), true, "the broker never became ready");
+  saveBrokerSession(workspace, brokerRecord(workspace, broker, canonicalHome));
+  await waitFor(() => fs.readFileSync(broker.logFile, "utf8").includes("supervision: armed"));
+  await waitFor(() => fs.existsSync(pidReport));
+  const appServerPid = Number(fs.readFileSync(pidReport, "utf8").trim());
+  t.after(() => killGroup(appServerPid, "SIGKILL"));
+
+  clearBrokerSession(workspace);
+
+  // A graceful shutdown is impossible here, so this passes only because the wait
+  // for one is bounded.
+  await waitFor(() => !isProcessAlive(broker.child.pid), { timeoutMs: 20000 });
+  // R3 wants the app-server to go with its broker, and the bound must not trade
+  // that away: what close() could not achieve, the escalation past it must.
+  await waitFor(() => !isProcessAlive(appServerPid));
+  // Nor may the bound trade away the removals, which need neither the peer nor
+  // the child.
+  assert.equal(fs.existsSync(broker.pidFile), false);
+  assert.equal(fs.existsSync(broker.logFile), false);
+  assert.equal(fs.existsSync(parseBrokerEndpoint(broker.endpoint).path), false);
+  assert.equal(fs.existsSync(broker.sessionDir), false);
+  assert.equal(loadBrokerSession(workspace), null);
+});
+
+// The two halves of the pid-provenance rule. An absent pid file means opposite
+// things depending on where the pid came from, and teardownBrokerSession
+// signals process *groups*, so getting this backwards on either side is a real
+// hazard: a needless group signal on one, a surviving broker on the other.
+test("teardownBrokerSession does not signal a record-sourced pid that no pid file confirms", async (t) => {
+  const sessionDir = createBrokerSessionDir();
+  const pidFile = path.join(sessionDir, "broker.pid");
+  const logFile = path.join(sessionDir, "broker.log");
+  const survivor = spawnDetachedSleeper(t);
+  fs.writeFileSync(logFile, "broker log\n", "utf8");
+  // The subject: a persisted record naming a pid, and no pid file anywhere —
+  // exactly what a broker that shut down cleanly leaves behind, after which
+  // that pid may belong to an unrelated process.
+  assert.equal(fs.existsSync(pidFile), false, "this test's subject is a record with no pid file beside it");
+
+  teardownBrokerSession({ endpoint: null, pidFile, logFile, sessionDir, pid: survivor.pid, pidSource: "record" });
+
+  // A delivered group SIGTERM kills this sleeper within milliseconds, so "was
+  // not signalled" is only observable across a window; asserting the instant
+  // teardown returns would pass even if the signal had gone out.
+  await new Promise((resolve) => setTimeout(resolve, 500));
+  assert.equal(isProcessAlive(survivor.pid), true, "an unconfirmed record-sourced pid must not be signalled");
+  // The artifact removals do not depend on the signal decision.
+  assert.equal(fs.existsSync(logFile), false);
+  assert.equal(fs.existsSync(sessionDir), false);
+});
+
+test("teardownBrokerSession kills a just-spawned pid that has not written its pid file yet", async (t) => {
+  const sessionDir = createBrokerSessionDir();
+  const pidFile = path.join(sessionDir, "broker.pid");
+  const logFile = path.join(sessionDir, "broker.log");
+  const child = spawnDetachedSleeper(t);
+  fs.writeFileSync(logFile, "broker log\n", "utf8");
+  // The broker writes its pid file early in main() but after Node bootstrap, so
+  // this is the state a legitimate just-spawned child is in when the not-ready
+  // path gives up on it. R4 requires that child to die anyway.
+  assert.equal(fs.existsSync(pidFile), false, "this test's subject is a child that has written no pid file");
+
+  teardownBrokerSession({ endpoint: null, pidFile, logFile, sessionDir, pid: child.pid, pidSource: "spawned" });
+
+  await waitFor(() => !isProcessAlive(child.pid));
+  assert.equal(fs.existsSync(sessionDir), false);
+});
+
+test("a SIGTERMed broker exits even with a half-open peer and an app-server that will not die", async (t) => {
+  const workspace = makeWorkspace();
+  const binDir = makeTempDir();
+  const pidReport = path.join(binDir, "wedged-app-server.pid");
+  installWedgedCodex(binDir, pidReport);
+  const canonicalHome = makeCanonicalHome();
+  const broker = startSupervisedBroker({
+    workspace,
+    binDir,
+    canonicalHome,
+    idleTimeoutMs: 60000,
+    superviseIntervalMs: 100
+  });
+  t.after(() => killGroup(broker.child.pid, "SIGKILL"));
+
+  assert.equal(await waitForBrokerEndpoint(broker.endpoint, 10000), true, "the broker never became ready");
+  saveBrokerSession(workspace, brokerRecord(workspace, broker, canonicalHome));
+  await waitFor(() => fs.existsSync(pidReport));
+  const appServerPid = Number(fs.readFileSync(pidReport, "utf8").trim());
+  t.after(() => killGroup(appServerPid, "SIGKILL"));
+  await connectHalfOpenPeer(t, broker.endpoint);
+
+  // This is how teardownBrokerSession actually reaches a broker: terminateProcessTree
+  // SIGTERMs the group and never escalates to SIGKILL. The record it leaves in
+  // place still names this broker, so supervision would decide to continue --
+  // nothing outside this process will finish the job, so the signal handler's own
+  // path has to.
+  killGroup(broker.child.pid, "SIGTERM");
+
+  await waitFor(() => !isProcessAlive(broker.child.pid), { timeoutMs: 20000 });
+  // The app-server ignores SIGTERM, so it can only be gone if the broker
+  // escalated on its way out.
+  await waitFor(() => !isProcessAlive(appServerPid));
+  assert.equal(fs.existsSync(broker.pidFile), false);
+  assert.equal(fs.existsSync(broker.logFile), false);
+  assert.equal(fs.existsSync(parseBrokerEndpoint(broker.endpoint).path), false);
+  assert.equal(fs.existsSync(broker.sessionDir), false);
+});
