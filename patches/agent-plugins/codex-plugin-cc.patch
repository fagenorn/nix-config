+test("a timeout whose deadline is unrepresentable still lands a complete job record", () => {
+  const repo = makeRepo();
+  const binDir = makeTempDir();
+  installFakeCodex(binDir, "slow-task");
+  const env = buildEnv(binDir);
+
+  // 1e18 ms clears the `Number.isFinite(timeoutMs) && timeoutMs > 0` guard on
+  // --timeout-ms, but createdAt + 1e18 lands outside the ±8.64e15 ms range a
+  // Date can represent, so `new Date(...).toISOString()` throws RangeError. The
+  // deadline used to be resolved *after* the detached worker was spawned and
+  // before the record was written, so that throw orphaned a running worker with
+  // no job record at all.
+  const launched = run(
+    "node",
+    [SCRIPT, "task", "--background", "--timeout-ms", "1e18", "--json", "investigate the failing test"],
+    { cwd: repo, env }
+  );
+  assert.equal(launched.status, 0, launched.stderr);
+  const { jobId, logFile } = JSON.parse(launched.stdout);
+
+  const jobFile = path.join(resolveStateDir(repo), "jobs", `${jobId}.json`);
+  assert.equal(fs.existsSync(jobFile), true, jobFile);
+  const record = JSON.parse(fs.readFileSync(jobFile, "utf8"));
+  assert.equal(record.id, jobId);
+  assert.equal(record.request.timeoutMs, 1e18);
+  assert.equal(record.logFile, logFile);
+  assert.equal(Number.isFinite(record.pid), true, JSON.stringify(record.pid));
+  // An unrepresentable deadline is no deadline: the key is absent, exactly as it
+  // is for a job launched without a timeout at all.
+  assert.equal("deadlineAt" in record, false, JSON.stringify(record.deadlineAt));
+
+  // The worker is tracked, not orphaned: it owns this record and writes its own
+  // outcome into it. (The clamped setTimeout makes it time out promptly, so the
+  // terminal status is failed; what matters is that the record receives it.)
+  const waited = run("node", [SCRIPT, "status", jobId, "--wait", "--timeout-ms", "15000", "--json"], {
+    cwd: repo,
+    env
+  });
+  assert.equal(waited.status, 0, waited.stderr);
+  const job = JSON.parse(waited.stdout).job;
+  assert.equal(job.status, "failed");
+  assert.equal(job.overdue, false);
+  assert.equal(job.deadlineAt, undefined);
+});
